# HaggleBoard runtime environment. Placeholders only. Never commit real values.
SITE_URL=https://haggleboard.com
# Optional. Without it the site serves the committed snapshot and stores nothing.
DATABASE_URL=
# Required when VERCEL=1. Salt used to hash client IPs for rate limiting.
MCP_CALL_LOG_SALT=
# Required to store a need or hide one with the poster's token.
DELETE_TOKEN_KEY=
# Set to 1 only on the public production deploy. Previews stay noindex.
HB_PUBLIC=
# Store bids stay off unless BID_KEYS_ENABLED is 1, true or yes.
BID_TOKEN_SIGNING_KEY=
BID_KEYS_ENABLED=
