{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://haggleboard.com/spec/need.schema.json",
  "title": "Need",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "text": { "type": "string", "maxLength": 500 },
    "brand": { "type": "string", "maxLength": 80 },
    "model": { "type": "string", "maxLength": 120 },
    "gender": { "enum": ["women", "men", "unisex", "kids"] },
    "size": { "type": "string", "maxLength": 32 },
    "max_price": { "type": "number", "exclusiveMinimum": 0, "description": "Inclusive maximum in major units. Free text 'under 130' is stricter: the price must be below 130." },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "region": { "type": "string" },
    "country": { "type": "string" },
    "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
  }
}
